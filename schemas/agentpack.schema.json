{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boman-ng/agentpack/schemas/agentpack.schema.json",
  "title": "AgentPack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version", "description", "instructions", "skills", "mcp", "profiles", "targets", "native"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global"],
      "properties": { "global": { "type": "string" } }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "sources"],
      "properties": {
        "catalog": { "type": "string" },
        "sources": { "type": "string" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog"],
      "properties": { "catalog": { "type": "string" } }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": { "directory": { "type": "string" } }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "kimi", "opencode"] }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "kimi"],
      "properties": {
        "codex": { "type": "string" },
        "kimi": { "type": "string" }
      }
    }
  }
}
